<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/music_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="@drawable/rill_music_background">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="音乐" android:textSize="24sp" android:textColor="#09255F"/>
 <TextView android:id="@+id/music_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="等待一首喜欢的歌" android:textSize="16sp" android:textColor="#09255F" android:singleLine="true" android:ellipsize="end"/>
 <TextView android:id="@+id/music_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="在 Rill 中选择歌单" android:textSize="12sp" android:textColor="#58719C" android:singleLine="true"/>
 <ProgressBar android:id="@+id/music_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="12dp" android:progressTint="#2F69FF" android:progressBackgroundTint="#CFDAF7"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
 <TextView android:id="@+id/music_previous" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="❮" android:textSize="20sp" android:textColor="#235DE6" android:contentDescription="上一首"/>
 <TextView android:id="@+id/music_toggle" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:background="@drawable/rill_music_button" android:text="▶" android:textColor="#FFFFFF" android:contentDescription="播放或暂停"/>
 <TextView android:id="@+id/music_next" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="❯" android:textSize="20sp" android:textColor="#235DE6" android:contentDescription="下一首"/>
 <TextView android:id="@+id/music_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="end|center_vertical" android:text="打开 ↗" android:textSize="12sp" android:textColor="#648FFF"/>
 </LinearLayout>
</LinearLayout>